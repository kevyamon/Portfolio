{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    
    "allowJs": true,
    "checkJs": false,
    "strict": false
  },
  "include": ["src", "vite.config.js"],
  "exclude": ["node_modules", "dist"]
}